---
import Icon from './Icon.astro';
import { profile, links } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-5 py-8 text-sm text-muted sm:flex-row">
    <p>© {year} {profile.fullName}</p>
    <div class="flex items-center gap-2">
      <a href={links.github} target="_blank" rel="noopener" aria-label="GitHub" class="grid h-9 w-9 place-items-center rounded-full hover:bg-card hover:text-ink"><Icon name="github" class="h-4.5 w-4.5" /></a>
      <a href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid h-9 w-9 place-items-center rounded-full hover:bg-card hover:text-ink"><Icon name="linkedin" class="h-4.5 w-4.5" /></a>
      <a href={`mailto:${links.email}`} aria-label="E-mail" class="grid h-9 w-9 place-items-center rounded-full hover:bg-card hover:text-ink"><Icon name="mail" class="h-4.5 w-4.5" /></a>
    </div>
  </div>
</footer>
