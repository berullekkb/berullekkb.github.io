---
import { about, timeline, skills, languages, certifications, engagements } from '../data/profile';
import Icon from './Icon.astro';
---

<div class="space-y-12">
  <!-- Présentation -->
  <section aria-labelledby="titre-presentation">
    <h2 id="titre-presentation" class="font-display text-2xl font-bold">Qui suis-je ?</h2>
    <div class="mt-4 space-y-3 text-[17px] leading-relaxed text-muted">
      {about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- Parcours -->
  <section aria-labelledby="titre-parcours">
    <h2 id="titre-parcours" class="font-display text-2xl font-bold">Parcours</h2>
    <ol class="relative mt-6 space-y-6 border-l-2 border-line pl-7">
      {timeline.map((item) => (
        <li class="relative">
          <span
            class:list={[
              'absolute -left-[37px] top-1.5 h-4 w-4 rounded-full border-4 border-paper',
              item.type === 'experience' ? 'bg-accent' : 'bg-muted',
            ]}
            aria-hidden="true"
          ></span>
          <div class="rounded-2xl border border-line bg-card p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class:list={[
                  'rounded-full px-2.5 py-0.5 text-xs font-bold',
                  item.type === 'experience' ? 'bg-accent-soft text-accent' : 'bg-paper text-muted',
                ]}
              >
                {item.type === 'experience' ? 'Expérience' : 'Formation'}
              </span>
              <span class="text-sm font-semibold text-muted">{item.period}</span>
            </div>
            <h3 class="mt-3 font-display text-lg font-bold">{item.title}</h3>
            <p class="text-[15px] font-semibold text-muted">{item.org}</p>
            {item.description && <p class="mt-2 text-[15px] text-muted">{item.description}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Compétences -->
  <section aria-labelledby="titre-competences">
    <h2 id="titre-competences" class="font-display text-2xl font-bold">Compétences</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {skills.map((group) => (
        <div class="rounded-2xl border border-line bg-card p-5">
          <h3 class="text-sm font-bold uppercase tracking-wider text-accent">{group.category}</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {group.items.map((s) => (
              <li class="rounded-lg border border-line px-3 py-1.5 text-sm font-semibold">{s}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Certifications -->
  <section aria-labelledby="titre-certifications">
    <h2 id="titre-certifications" class="font-display text-2xl font-bold">Certifications</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {certifications.map((c) => (
        <li class="flex flex-col overflow-hidden rounded-2xl border border-line bg-card">
          {c.image && (
            <a href={c.image} target="_blank" rel="noopener" class="block overflow-hidden border-b border-line bg-paper" aria-label={`Agrandir le certificat ${c.name}`}>
              <img
                src={c.image}
                alt={`Certificat ${c.name} (${c.issuer})`}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover object-top transition duration-300 hover:scale-[1.03]"
              />
            </a>
          )}
          <div class="flex flex-1 flex-col px-5 py-4">
            <div class="flex items-center justify-between gap-2">
              <p class="text-xs font-bold uppercase tracking-wider text-accent">{c.issuer}</p>
              {c.date && <span class="text-sm font-semibold text-muted">{c.date}</span>}
            </div>
            <p class="mt-1 font-bold">{c.name}</p>
            {c.kind && <p class="text-sm text-muted">{c.kind}</p>}
            {c.url && (
              <a href={c.url} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold text-accent hover:underline">
                Vérifier le certificat <Icon name="external" class="h-4 w-4" />
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Engagements associatifs -->
  <section aria-labelledby="titre-engagements">
    <h2 id="titre-engagements" class="font-display text-2xl font-bold">Engagements associatifs</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {engagements.map((e) => (
        <li class="rounded-2xl border border-line bg-card px-5 py-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-bold">{e.role}</p>
            {e.period && <span class="text-sm font-semibold text-muted">{e.period}</span>}
          </div>
          <p class="text-[15px] font-semibold text-muted">{e.org}</p>
          {e.description && <p class="mt-2 text-[15px] text-muted">{e.description}</p>}
        </li>
      ))}
    </ul>
  </section>

  <!-- Langues -->
  <section aria-labelledby="titre-langues">
    <h2 id="titre-langues" class="font-display text-2xl font-bold">Langues</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {languages.map((l) => (
        <li class="flex items-center justify-between rounded-2xl border border-line bg-card px-5 py-4">
          <span class="font-bold">{l.name}</span>
          <span class="text-sm text-muted">{l.level}</span>
        </li>
      ))}
    </ul>
  </section>
</div>
