---
import Icon from './Icon.astro';
import { profile, links, stats } from '../data/profile';
---

<section class="dot-grid">
  <div class="mx-auto max-w-5xl px-5 pb-10 pt-14 sm:pt-20">
    <!-- Profil -->
    <div class="reveal flex flex-col-reverse items-center gap-10 md:flex-row md:items-center md:justify-between">
      <div class="text-center md:text-left">
        {profile.availability && (
          <p class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-3.5 py-1.5 text-sm font-semibold text-muted">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            </span>
            {profile.availability}
          </p>
        )}

        <h1 class="mt-5 font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
          {profile.firstName}<br />
          <span class="text-accent">{profile.lastName}</span>
        </h1>
        <p class="mt-4 text-lg font-semibold sm:text-xl">{profile.title}</p>
        <p class="mt-2 max-w-md text-muted md:max-w-sm">{profile.tagline}</p>

        <div class="mt-5 flex items-center justify-center gap-4 text-sm text-muted md:justify-start">
          <span class="inline-flex items-center gap-1.5"><Icon name="pin" class="h-4 w-4" />{profile.location}</span>
          <span class="h-4 w-px bg-line"></span>
          <a href={links.github} target="_blank" rel="noopener" aria-label="Mon GitHub" class="transition-colors hover:text-accent"><Icon name="github" /></a>
          <a href={links.linkedin} target="_blank" rel="noopener" aria-label="Mon LinkedIn" class="transition-colors hover:text-accent"><Icon name="linkedin" /></a>
        </div>
      </div>

      <!-- Photo -->
      <div class="relative shrink-0">
        <div class="absolute -inset-3 rotate-6 rounded-[2.2rem] bg-accent/15"></div>
        <img
          src={profile.photo}
          alt={`Photo de ${profile.fullName}`}
          width="240"
          height="240"
          class="relative h-48 w-48 rounded-[2rem] border-4 border-card object-cover shadow-xl sm:h-60 sm:w-60"
        />
      </div>
    </div>

    <!-- Chiffres clés -->
    <dl class="reveal mt-14 grid grid-cols-3 divide-x divide-line rounded-2xl border border-line bg-card">
      {stats.map((s) => (
        <div class="flex flex-col-reverse px-2 py-5 text-center sm:py-6">
          <dt class="mt-1 text-xs font-medium text-muted sm:text-sm">{s.label}</dt>
          <dd class="font-display text-3xl font-bold text-ink sm:text-4xl">
            <span class="counter" data-target={s.value}>{s.value}</span><span class="text-accent">{s.suffix}</span>
          </dd>
        </div>
      ))}
    </dl>

    <!-- Boutons d'action -->
    <div class="reveal mt-5 flex gap-3">
      <a
        href={profile.cv}
        download
        class="flex flex-1 items-center justify-center gap-2.5 whitespace-nowrap rounded-2xl bg-accent px-4 py-4 sm:px-6 font-bold text-white shadow-lg shadow-accent/25 transition hover:bg-accent-strong hover:shadow-accent/40 dark:text-paper"
      >
        <span>Télécharger<span class="hidden sm:inline"> mon</span> CV</span>
        <Icon name="download" />
      </a>
      <a
        href={links.linkedin}
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        class="grid w-14 shrink-0 place-items-center sm:w-16 rounded-2xl border border-line bg-card text-ink transition hover:border-accent hover:text-accent"
      >
        <Icon name="linkedin" class="h-6 w-6" />
      </a>
      <a
        href={`mailto:${links.email}`}
        aria-label="M'envoyer un e-mail"
        class="grid w-14 shrink-0 place-items-center sm:w-16 rounded-2xl border border-line bg-card text-ink transition hover:border-accent hover:text-accent"
      >
        <Icon name="mail" class="h-6 w-6" />
      </a>
    </div>
  </div>
</section>

<script>
  // Compteurs animés : de 0 à la valeur cible quand ils deviennent visibles
  function initCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.counter:not([data-done])');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const animate = (el: HTMLElement) => {
      el.dataset.done = '1';
      const target = Number(el.dataset.target);
      if (reduce) return;
      const start = performance.now();
      const duration = 1200;
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0';
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          animate(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      });
    });
    counters.forEach((c) => io.observe(c));
  }
  document.addEventListener('astro:page-load', initCounters);
</script>
