---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { readingTime, formatDate } from '../../utils/readingTime';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Blog" description="Articles de Berulle KAMDEM KAMDEM sur la data, l'IA et l'apprentissage.">
  <div class="mx-auto max-w-3xl px-5 pt-14">
    <header class="reveal">
      <p class="text-sm font-bold uppercase tracking-widest text-accent">Écrits</p>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">Blog</h1>
      <p class="mt-3 text-muted">Ce que j'apprends, ce que je construis, ce que j'en retiens.</p>
    </header>

    <ul class="mt-10 space-y-4">
      {posts.map((post) => (
        <li class="reveal">
          <a href={`/blog/${post.id}/`} class="group block rounded-2xl border border-line bg-card p-6 transition hover:border-accent/40 hover:shadow-[0_18px_40px_-24px_rgba(80,60,200,0.35)]">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span aria-hidden="true">·</span>
              <span>{readingTime(post.body)}</span>
            </div>
            <h2 class="mt-2 font-display text-xl font-bold group-hover:text-accent">{post.data.title}</h2>
            <p class="mt-2 text-muted">{post.data.description}</p>
            <div class="mt-4 flex items-center justify-between">
              <ul class="flex flex-wrap gap-1.5">
                {post.data.tags.map((t) => <li class="rounded-md bg-paper px-2 py-1 text-xs font-semibold text-muted">#{t}</li>)}
              </ul>
              <Icon name="arrow" class="h-5 w-5 text-accent transition-transform group-hover:translate-x-1" />
            </div>
          </a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && <p class="mt-10 text-muted">Premier article bientôt en ligne.</p>}
  </div>
</BaseLayout>
