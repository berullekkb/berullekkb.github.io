---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, subtitle, tech, cover, github, demo, category, date } = project.data;
---

<BaseLayout title={title} description={subtitle} image={cover} type="article">
  <article class="mx-auto max-w-3xl px-5 pt-12">
    <a href="/projects/" class="inline-flex items-center gap-1.5 text-sm font-bold text-muted hover:text-accent">
      <Icon name="arrow" class="h-4 w-4 rotate-180" /> Tous les projets
    </a>

    <header class="mt-6">
      <div class="flex items-center gap-3 text-sm font-semibold text-muted">
        <span class="rounded-full bg-accent-soft px-3 py-1 text-accent">{category}</span>
        <time datetime={date.toISOString()}>{date.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })}</time>
      </div>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-3 text-lg text-muted">{subtitle}</p>

      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
        {tech.map((t) => <li class="rounded-lg border border-line bg-card px-3 py-1.5 text-sm font-semibold">{t}</li>)}
      </ul>

      {(github || demo) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {github && (
            <a href={github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl bg-ink px-5 py-3 font-bold text-paper transition hover:opacity-90">
              <Icon name="github" /> Code source
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-line bg-card px-5 py-3 font-bold transition hover:border-accent hover:text-accent">
              <Icon name="external" /> Voir la démo
            </a>
          )}
        </div>
      )}
    </header>

    {cover && (
      <img
        src={cover}
        alt={`Aperçu du projet ${title}`}
        class="mt-10 aspect-[16/9] w-full rounded-2xl border border-line object-cover"
        transition:name={`cover-${project.id}`}
      />
    )}

    <div class="prose prose-lg mt-10 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-accent prose-img:rounded-xl">
      <Content />
    </div>
  </article>
</BaseLayout>
